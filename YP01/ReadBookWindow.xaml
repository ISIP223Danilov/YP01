<Window x:Class="YP01.ReadBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чтение книги" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <TextBlock x:Name="tbl_book_content" TextWrapping="Wrap" />
        </ScrollViewer>

        <Button Grid.Row="1" Content="Закрыть" Width="100" Height="30" Click="btn_close_Click"/>
    </Grid>
</Window>
