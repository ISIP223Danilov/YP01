<Page x:Class="YP01.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница книги"
      Background="#F5F5F5">

    <ScrollViewer>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Обложка + информация -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Image x:Name="img_book_cover" Width="150" Height="200" Stretch="Uniform" Margin="0,0,15,0"/>
                <StackPanel>
                    <TextBlock x:Name="tbl_title" FontWeight="Bold" FontSize="18" Margin="0,0,0,5"/>
                    <TextBlock x:Name="tbl_author" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBlock x:Name="tbl_genres" FontSize="12" Foreground="#555" Margin="0,0,0,5"/>
                    <TextBlock x:Name="tbl_description" TextWrapping="Wrap" MaxWidth="500" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <!-- Кнопки -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,15">
                <Button Content="Читать" Width="100" Click="btn_read_Click" Height="35" Margin="0,0,10,0"/>
                <CheckBox x:Name="chb_freeze_book" Content="Заморозить книгу" Visibility="Collapsed" 
                          Checked="freeze_book_chb_Checked" Unchecked="freeze_book_chb_Unchecked" 
                          VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- Жалоба -->
            <Border Grid.Row="2" Background="#F9F9F9" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Пожаловаться" FontWeight="Bold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,10">
                        <RadioButton x:Name="rb_complaint_book" Content="На книгу" IsChecked="True" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rb_complaint_author" Content="На автора" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rb_complaint_review" Content="На отзыв" Margin="0,0,15,0"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBox x:Name="tb_complaint" Width="400" Height="30" Margin="0,0,10,0" Padding="5"/>
                        <Button Content="📨 Отправить жалобу" Width="150" Click="btn_submit_complaint_Click" Height="30"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ========== БЛОК ОТЗЫВА (ДОБАВЛЕН) ========== -->
            <Border Grid.Row="3" Background="#F9F9F9" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Оставить отзыв" FontWeight="Bold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBox x:Name="tb_review" Width="400" Height="60" Margin="0,0,10,0" 
                                 Padding="5" TextWrapping="Wrap" ToolTip="Введите ваш отзыв"/>
                        <TextBlock Text="Оценка:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cbb_rating" Width="60" Height="30" Margin="0,0,10,0">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10" IsSelected="True"/>
                        </ComboBox>
                        <Button x:Name="btn_submit_review" Content="Оставить отзыв" 
                                Width="150" Click="btn_submit_review_Click" Height="35"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Отзывы -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="Отзывы" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,10">
                    <CheckBox x:Name="chb_freeze_review" Content="🔒 Заморозить отзыв" Visibility="Collapsed" 
                              Checked="freeze_review_chb_Checked" Unchecked="freeze_review_chb_Unchecked"/>
                </WrapPanel>

                <DataGrid x:Name="dg_reviews" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="dg_reviews_SelectionChanged"
                          Margin="0,0,0,10" MinHeight="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Автор" Binding="{Binding user_name}" Width="150"/>
                        <DataGridTextColumn Header="Оценка" Binding="{Binding rating}" Width="60"/>
                        <DataGridTextColumn Header="Текст" Binding="{Binding text}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>