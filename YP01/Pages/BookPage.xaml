<Page x:Class="YP01.Pages.BookPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница книги">
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image x:Name="img_book_cover" Width="150" Height="200" Stretch="Uniform"/>
                <StackPanel>
                    <TextBlock x:Name="tbl_title" FontWeight="Bold"/>
                    <TextBlock x:Name="tbl_author"/>
                    <TextBlock x:Name="tbl_genres"/>
                    <TextBlock x:Name="tbl_description" TextWrapping="Wrap" MaxWidth="500"/>
                </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Row="1">
                <Button Content="Читать" Width="100" Click="btn_read_Click"/>
                <CheckBox x:Name="chb_freeze_book" Content="Заморозить книгу" Visibility="Collapsed" Checked="freeze_book_chb_Checked" Unchecked="freeze_book_chb_Unchecked"/>
            </WrapPanel>

            <GroupBox Grid.Row="2" Header="Пожаловаться">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rb_complaint_book" Content="На книгу" IsChecked="True"/>
                    <RadioButton x:Name="rb_complaint_author" Content="На автора"/>
                    <RadioButton x:Name="rb_complaint_review" Content="На отзыв (ниже)"/>
                    <TextBox x:Name="tb_complaint" Width="300"/>
                    <Button Content="Отправить жалобу" Width="150" Click="btn_submit_complaint_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Оставить отзыв">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="tb_review" Width="350"/>
                    <TextBlock Text="Оценка:"/>
                    <ComboBox x:Name="cbb_rating" Width="50">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10" IsSelected="True"/>
                    </ComboBox>
                    <Button Content="Оставить отзыв" Width="150" Click="btn_submit_review_Click"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Row="4">
                <TextBlock Text="Отзывы:" />

                <WrapPanel>
                    <CheckBox x:Name="chb_freeze_review" Content="Заморозить отзыв" Visibility="Collapsed" Checked="freeze_review_chb_Checked" Unchecked="freeze_review_chb_Unchecked"/>
                </WrapPanel>

                <DataGrid x:Name="dg_reviews" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dg_reviews_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Автор" Binding="{Binding user_name}" Width="150"/>
                        <DataGridTextColumn Header="Оценка" Binding="{Binding rating}" Width="60"/>
                        <DataGridTextColumn Header="Текст" Binding="{Binding text}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
