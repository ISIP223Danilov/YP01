<Page x:Class="YP01.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница автора"
      Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Добавить книгу" Click="btn_add_book_Click" Padding="15,8" Margin="0,0,10,0"/>
            <Button Content="Жанры" Click="btn_edit_genres_Click" Padding="15,8" Margin="0,0,10,0"/>
            <Button Content="Оспорить заморозку" Click="btn_challenge_freeze_Click" Padding="15,8" Margin="0,0,10,0"/>
            <TextBox x:Name="tb_against" Width="200" Padding="5" ToolTip="Причина оспаривания"/>
        </StackPanel>

        <!-- Таблица книг автора -->
        <DataGrid Grid.Row="1" x:Name="dg_published_books" AutoGenerateColumns="False"
                  CanUserAddRows="False" CellEditEnding="dg_books_CellEditEnding"
                  SelectionChanged="dg_books_SelectionChanged" SelectionMode="Single"
                  Margin="0,0,0,15" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Dname}" Width="200"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Обложка" Binding="{Binding CoveringUri}" Width="150"/>
                <DataGridCheckBoxColumn Header="Заморожена" Binding="{Binding IsFrozen}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Редактирование содержимого -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="Содержимое книги:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
            <Button Content="Сохранить содержимое" Click="btn_save_content_Click" Padding="15,8"/>
        </StackPanel>

        <!-- Текст книги -->
        <TextBox Grid.Row="5" x:Name="tb_book_content" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"
                 Padding="10"
                 FontSize="13"
                 BorderBrush="#CCC"
                 BorderThickness="1"/>
    </Grid>
</Page>