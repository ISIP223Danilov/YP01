<Page x:Class="YP01.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с текстовыми кнопками -->
        <Border Grid.Column="0" Background="#2C3E50">
            <ItemsControl x:Name="sidebar_items_control">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="sidebar_btn_Click" 
                                Tag="{Binding page_uri}" 
                                Content="{Binding title}"
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="15,12"
                                Margin="0"
                                Foreground="White"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="0"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Frame x:Name="fr_the_main" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>