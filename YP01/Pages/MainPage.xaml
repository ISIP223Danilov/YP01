<Page x:Class="YP01.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="#2C3E50">
            <ItemsControl x:Name="sidebar_items_control">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="sidebar_btn_Click" 
                                Tag="{Binding page_uri}" 
                                ToolTip="{Binding title}"
                                Background="Transparent" 
                                BorderThickness="0" 
                                Margin="0"
                                Padding="0"
                                Width="100"
                                Height="70"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <Image Source="{Binding image_uri}" 
                                   Width="100" 
                                   Height="100"
                                   Stretch="Uniform"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Frame x:Name="fr_the_main" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>