<Page x:Class="YP01.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация/Регистрация"
      Background="#F5F5F5">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="White" 
                CornerRadius="15" 
                Padding="30" 
                Width="400"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Читай, Пиши и не спиши" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"
                           Foreground="#2C3E50"/>

                <!-- Переключатель Авторизация / Регистрация -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <RadioButton x:Name="rb_login" 
                                 Content="Авторизация" 
                                 IsChecked="True" 
                                 Checked="mode_Checked"
                                 FontSize="14"
                                 Margin="0,0,15,0"
                                 Padding="10,5"/>
                    <RadioButton x:Name="rb_register" 
                                 Content="Регистрация" 
                                 Checked="mode_Checked"
                                 FontSize="14"
                                 Padding="10,5"/>
                </StackPanel>

                <!-- Поле Логин -->
                <TextBlock Text="Логин" Margin="0,0,0,5" FontSize="12" Foreground="Gray"/>
                <TextBox x:Name="tb_login" Height="40" Margin="0,0,0,15" Padding="10" FontSize="14"/>

                <!-- Поле Пароль -->
                <TextBlock Text="Пароль" Margin="0,0,0,5" FontSize="12" Foreground="Gray"/>
                <PasswordBox x:Name="pb_password" Height="40" Margin="0,0,0,15" Padding="10" FontSize="14"/>

                <!-- Дополнительные поля для регистрации -->
                <StackPanel x:Name="sp_register_fields" Visibility="Collapsed">
                    <TextBlock Text="Email" Margin="0,0,0,5" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="tb_email" Height="40" Margin="0,0,0,15" Padding="10" FontSize="14"/>

                    <TextBlock Text="Отображаемое имя" Margin="0,0,0,5" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="tb_display_name" Height="40" Margin="0,0,0,15" Padding="10" FontSize="14"/>
                </StackPanel>

                <!-- Кнопка подтверждения -->
                <Button x:Name="btn_submit" 
                        Content="Подтвердить" 
                        Click="btn_submit_Click" 
                        Height="45" 
                        Margin="0,10,0,0"
                        Background="#2C3E50"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
