<Page x:Class="YP01.Pages.AdminSub.FrozenItemsPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="FrozenItemsPage">
    <Grid>
        <DataGrid x:Name="dg_frozen_items" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" Binding="{Binding item_type}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Название" Binding="{Binding title}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding author}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding description}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Содержимое" Binding="{Binding content}" Width="*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Заморожен?" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding is_frozen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="freeze_chb_Checked" Unchecked="freeze_chb_Unchecked"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
