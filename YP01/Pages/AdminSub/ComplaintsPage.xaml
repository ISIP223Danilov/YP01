<Page x:Class="YP01.Pages.AdminSub.ComplaintsPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ComplaintsPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Принять" Click="btn_accept_Click" Padding="10,5"/>
            <Button Content="Отклонить" Click="btn_reject_Click" Padding="10,5"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dg_complaints" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="От кого" Binding="{Binding user_name}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Цель" Binding="{Binding target_type}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Детали (для отзыва -- текст)" Binding="{Binding target_details}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Причина" Binding="{Binding reason}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

