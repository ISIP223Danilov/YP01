<Page x:Class="YP01.Pages.ProfilePage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Профиль пользователя" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Имя:"  Width="100"/>
                <TextBlock x:Name="tbl_display_name"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Логин:"  Width="100"/>
                <TextBlock x:Name="tbl_login"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Email:"  Width="100"/>
                <TextBlock x:Name="tbl_email"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Роль:"  Width="100"/>
                <TextBlock x:Name="tbl_role"/>
            </StackPanel>

            <Separator/>

            <StackPanel x:Name="sp_author_application" Visibility="Collapsed">
                <TextBlock Text="Подать заявку на роль Автора" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Обоснование:"/>
                    <TextBox x:Name="tb_author_reason" Width="300"/>
                </StackPanel>
                <Button Content="Подать заявку" Width="120" Click="btn_submit_author_application_Click"/>
                <Separator/>
            </StackPanel>

            <StackPanel x:Name="sp_freeze_warning" Visibility="Collapsed">
                <TextBlock Text="Ваш аккаунт заморожен!" Foreground="Red" />
                <TextBlock Text="Оспорить заморозку:" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Обоснование:"/>
                    <TextBox x:Name="tb_unfreeze_reason" Width="300"/>
                </StackPanel>
                <Button Content="Подать заявку" Width="120" Click="btn_submit_unfreeze_application_Click"/>
                <Separator/>
            </StackPanel>

            <TextBlock Text="Мои отзывы" />
            <DataGrid x:Name="dg_reviews" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Книга" Binding="{Binding book_title}" Width="200"/>
                    <DataGridTextColumn Header="Оценка" Binding="{Binding rating}" Width="60"/>
                    <DataGridTextColumn Header="Отзыв" Binding="{Binding text}" Width="*"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding created_at, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
    </ScrollViewer>
</Page>

