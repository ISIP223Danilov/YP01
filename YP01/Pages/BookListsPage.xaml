<Page x:Class="YP01.Pages.BookListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Списки книг">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Первая строка: выбор списка (оставляем как есть) -->
        <WrapPanel Grid.Row="0">
            <TextBlock Text="   Текущий список:" FontWeight="Bold" Width="145"/>
            <ComboBox x:Name="cbb_current_section" Width="394" SelectionChanged="cbb_current_section_SelectionChanged" Height="36" Margin="0,0,0,5"/>
        </WrapPanel>

        <!-- Вторая строка: поиск, фильтры, сортировка (СТОЛБИКОМ) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="  Название:" Margin="0,5,0,5" Height="22"/>
            <TextBox x:Name="tb_search_title" Width="305" TextChanged="filter_Changed" Height="41" Margin="0,0,0,10"/>

            <TextBlock Text="  Автор:" Margin="0,5,0,5"/>
            <TextBox x:Name="tb_search_author" Width="306" TextChanged="filter_Changed" Height="40" Margin="0,0,0,10"/>

            <TextBlock Text="  Сортировка:" Margin="0,5,0,5"/>
            <ComboBox x:Name="cbb_sort" Width="303" SelectionChanged="filter_Changed" Height="47" Margin="0,0,0,10">
                <ComboBoxItem Content="По умолчанию" IsSelected="True"/>
                <ComboBoxItem Content="По названию"/>
                <ComboBoxItem Content="По оценке"/>
            </ComboBox>

            <TextBlock Text="   Жанр:" Margin="0,5,0,5" Height="20"/>
            <ComboBox x:Name="cbb_genre" Width="304" SelectionChanged="filter_Changed" Height="48"/>
        </StackPanel>

        <!-- Третья строка: кнопки (оставляем как есть) -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button Content="Открыть книгу" Width="120" Click="btn_open_book_Click" Height="33" Margin="0,0,10,0"/>
            <TextBlock Text="Новый список:" Width="86" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbb_target_section" Width="120" Margin="0,0,10,0"/>
            <Button Content="Переместить" Click="btn_move_to_list_Click" Height="33"/>
        </WrapPanel>

        <!-- Четвёртая строка: список книг (оставляем как есть) -->
        <ListBox x:Name="dg_books" Grid.Row="3" SelectionMode="Single">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <Image Source="{Binding cover_path}" Width="50" Height="70" Stretch="Uniform" />
                        <TextBlock Text="{Binding title}" />
                        <TextBlock Text="{Binding author_name}" />
                        <TextBlock Text="{Binding average_rating}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>