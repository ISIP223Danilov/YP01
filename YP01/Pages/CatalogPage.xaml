<Page x:Class="YP01.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Строка 1: поиск и фильтры -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <TextBox x:Name="tb_search_title" Width="150" TextChanged="filter_Changed" Margin="0,0,10,0" Height="30"/>

            <TextBlock Text="Автор:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <TextBox x:Name="tb_search_author" Width="150" TextChanged="filter_Changed" Margin="0,0,10,0" Height="30"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox x:Name="cbb_sort" Width="120" SelectionChanged="filter_Changed" Height="30" Margin="0,0,10,0">
                <ComboBoxItem Content="По умолчанию" IsSelected="True"/>
                <ComboBoxItem Content="По названию"/>
                <ComboBoxItem Content="По оценке"/>
            </ComboBox>

            <TextBlock Text="Жанр:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox x:Name="cbb_genre" Width="120" SelectionChanged="filter_Changed" Height="30"/>
        </WrapPanel>

        <!-- Строка 2: кнопки -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="Открыть книгу" Width="120" Click="btn_open_book_Click" Height="30" Margin="0,0,10,0"/>
            <TextBlock Text="Список:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox x:Name="cbb_reading_section" Width="120" Height="30" Margin="0,0,10,0"/>
            <Button Content="Добавить в список" Click="btn_add_to_list_Click" Height="30"/>
        </WrapPanel>

        <!-- Строка 3: список книг -->
        <ListBox x:Name="dg_books" Grid.Row="2" SelectionMode="Single">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5" Width="120">
                        <StackPanel Orientation="Vertical">
                            <Image Source="{Binding cover_path}" Width="80" Height="100" Stretch="Uniform" />
                            <TextBlock Text="{Binding title}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{Binding author_name}" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Text="{Binding average_rating}" TextAlignment="Center" FontSize="11"/>
                            <Button Content="Открыть" Click="btn_open_book_Click" Tag="{Binding}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>